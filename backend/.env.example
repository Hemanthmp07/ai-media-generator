# Environment Configuration

# Backend Settings
PORT=5000
NODE_ENV=development

# Optional: OpenAI API Key (for enhanced video generation)
# OPENAI_API_KEY=your_openai_api_key

# Optional: Database Configuration
# DATABASE_URL=sqlite:///ai_media.db
# DATABASE_URL=mongodb://localhost:27017/ai-media

# API Keys for Third-party Services
# POLLINATIONS_API_KEY=not_required (public API)

# CORS Settings
CORS_ORIGIN=http://localhost:5173
