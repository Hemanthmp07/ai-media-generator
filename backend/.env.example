# ===================================================
# AI Media Generator - Backend Environment Variables
# ===================================================

# Server Port (Render sets this automatically, default 10000 on Render)
PORT=5000

# Environment Mode (production / development)
NODE_ENV=production

# Allowed CORS Origins (comma-separated for multiple domains or * for all)
# Example for production: https://your-frontend.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# OpenAI API Key (Optional: used for OpenAI enhanced image generation)
OPENAI_API_KEY=your_openai_api_key_here
